# Copy this file to .env (or just set these as real environment variables on
# your host) and fill in real values for production. Neither is required for
# local development — sensible defaults are generated automatically.

# Secret used to sign login session cookies. If unset, the app generates one
# on first run and saves it to .session_secret next to app.py so sessions
# keep working across restarts. Set this explicitly in production so a fresh
# secret is never generated by accident (e.g. on platforms with an ephemeral
# filesystem, where .session_secret would be wiped on every redeploy).
SESSION_SECRET=change-me-to-a-long-random-string

# Hosted PostgreSQL connection string. This is required in production. Create a
# managed PostgreSQL database (for example Render Postgres or Neon) and paste
# its full connection string here. Never commit the real value.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require

# Port the server listens on. Most hosting platforms set this automatically —
# you usually don't need to set it yourself.
PORT=8000

# Optional local-only SQLite file. It is used only when DATABASE_URL is absent.
# Do not rely on SQLite on ephemeral hosting platforms such as free web tiers.
DB_FILE=campuspulse.sqlite
